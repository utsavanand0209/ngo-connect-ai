{
  "name": "ngo-connect-backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "license": "MIT",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node seed.js",
    "smoke": "node scripts/smokeTest.js",
    "data:curate:bangalore": "node scripts/bangaloreDataCuration.js",
    "scenario:detailed-ngos": "node scripts/seedDetailedNgos.js",
    "scenario:flood": "node scripts/floodDataAndFeatureTest.js",
    "scenario:roles": "node scripts/roleWorkflowScenario.js",
    "scenario:verification-interface": "node scripts/verificationInterfaceScenario.js",
    "eval:chatbot": "node scripts/chatbotEvaluation.js",
    "eval:chatbot:gemini": "node scripts/chatbotEvaluation.js --mode=gemini --strict",
    "smoke:webhook": "node scripts/webhookSmokeTest.js",
    "smoke:webhook:worker": "node scripts/webhookAutoRetrySmokeTest.js",
    "test:fraud": "node scripts/fraudScoringTest.js",
    "webhook:worker:tick": "node scripts/webhookWorkerTick.js",
    "webhook:cleanup": "node scripts/webhookCleanup.js",
    "webhook:receiver:example": "node scripts/webhookReceiverExample.js",
    "db:migrate:webhooks": "bash -lc 'source .env && psql \"$POSTGRES_URL\" -v ON_ERROR_STOP=1 -f sql/add_webhook_deliveries.sql'",
    "db:migrate:innovation": "bash -lc 'source .env && psql \"$POSTGRES_URL\" -v ON_ERROR_STOP=1 -f sql/add_innovation_features.sql'",
    "db:relational-schema": "bash -lc 'source .env && psql \"$POSTGRES_URL\" -v ON_ERROR_STOP=1 -f sql/normalized_schema.sql'"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.2.0",
    "nodemon": "^2.0.22"
  }
}
